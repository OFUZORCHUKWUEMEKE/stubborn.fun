{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stubborn-ledger",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // The ledger has no public surface: no workers.dev URL, no preview URLs,
  // no routes. Other Workers reach it only through a service binding to the
  // LedgerService entrypoint, which exposes a fixed set of operations.
  "workers_dev": false,
  "preview_urls": false,

  "durable_objects": {
    "bindings": [{ "name": "LEDGER", "class_name": "LedgerDurableObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LedgerDurableObject"] }],

  "vars": {
    // Platform fee on a settled pot, in basis points (1000 = 10%). Each game
    // records the rate in force when its first stake was locked, so a later
    // change never alters the terms of a game already in progress.
    "GAME_FEE_BPS": "1000"
  },

  "observability": { "enabled": true }
}
